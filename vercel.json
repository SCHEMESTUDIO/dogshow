{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/d/:slug", "destination": "/api/dog?slug=:slug" },
    { "source": "/breeds/:slug", "destination": "/api/breed?slug=:slug" },
    { "source": "/:slug", "destination": "/:slug.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, no-transform" }
      ]
    },
    {
      "source": "/sitemap-urls.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, no-transform" }
      ]
    }
  ]
}
